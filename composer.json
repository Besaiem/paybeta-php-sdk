{
    "name": "paybetaby/php-sdk",
    "description": "Official PHP SDK for the PayBeta payments API, with first-class Laravel support",
    "type": "library",
    "license": "MIT",
    "keywords": ["paybeta", "payments", "escrow", "sdk", "laravel", "nigeria", "ngn"],
    "homepage": "https://usepaybeta.com",
    "support": {
        "issues": "https://github.com/Besaiem/paybeta-php-sdk/issues",
        "source": "https://github.com/Besaiem/paybeta-php-sdk"
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.75",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel service provider and Paybeta facade (^10.0 || ^11.0 || ^12.0)"
    },
    "autoload": {
        "psr-4": {
            "Paybeta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Paybeta\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Paybeta\\Laravel\\PaybetaServiceProvider"
            ],
            "aliases": {
                "Paybeta": "Paybeta\\Laravel\\Facades\\Paybeta"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
